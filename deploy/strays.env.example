# Copy to /etc/strays.env on the server. Use placeholders only in the repo.
# Recommended ownership/permissions:
#   install -m 600 -o strays -g strays /dev/null /etc/strays.env
# Then edit it as root and replace every placeholder with a real value.

DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=strays.peerapeek.cc
CSRF_TRUSTED_ORIGINS=https://strays.peerapeek.cc
SECURE_HSTS_SECONDS=3600

# Optional hardening toggles (defaults shown).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Password-reset email. Without an SMTP configuration the production
# password-reset form cannot deliver mail.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@strays.peerapeek.cc
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-me
# EMAIL_HOST_PASSWORD=replace-me
# EMAIL_USE_TLS=True

# Push notification provider. Leave empty for development (no HTTP request).
# PUSH_PROVIDER_URL=https://push.example.com/send
# PUSH_TIMEOUT=10
# PUSH_MAX_ATTEMPTS=4
# PUSH_RETRY_DELAY=60

# Interview booking horizon and slot duration (defaults shown).
# INTERVIEW_BOOKING_HORIZON_DAYS=60
# INTERVIEW_SLOT_MINUTES=60
